---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({data}) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const all = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b)=>a.data.date.valueOf()-b.data.date.valueOf());
const words = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const mins = Math.max(1, Math.round(words / 200));
const dateStr = post.data.date.toISOString().slice(0,10);
let prev, next;
if (post.data.series) {
  const inSeries = all.filter((p)=>p.data.series===post.data.series);
  const i = inSeries.findIndex((p)=>p.id===post.id);
  prev = inSeries[i-1]; next = inSeries[i+1];
}
const related = all.filter((p)=>p.id!==post.id && p.data.tags.some((t:string)=>post.data.tags.includes(t))).slice(0,4);
---
<Base title={post.data.title} description={post.data.description}>
  <div class="wide"><div class="readcol">
    <h1 class="posttitle">{post.data.title}</h1>
    <p class="byline"><span>Chris Cerne</span><span>·</span><span>{dateStr}</span><span>·</span><span>{mins} min read</span><span>·</span>{post.data.tags.map((t:string)=>(<a class="tag" href={`/tags/${t}`}>{t}</a>))}</p>
    <article data-pagefind-body data-pagefind-meta={`title:${post.data.title}`} data-pagefind-filter={`tags:${post.data.tags.join(',')}`}>
      <Content />
    </article>
    {(prev || next || related.length>0) && (
      <aside class="more">
        <h3>More from this vein</h3>
        <ul>
          {prev && (<li>Previous in {post.data.series}: <a href={`/blog/${prev.id}`}>{prev.data.title}</a></li>)}
          {next && (<li>Next in {post.data.series}: <a href={`/blog/${next.id}`}>{next.data.title}</a></li>)}
          {related.map((p)=>(<li><a href={`/blog/${p.id}`}>{p.data.title}</a></li>))}
        </ul>
      </aside>
    )}
    <p class="identity">Chris Cerne — Security Engineer at Meta · <a href="/about">About</a> · <a href="/rss.xml">RSS</a> · <a href="https://github.com/cernec1999">GitHub</a></p>
  </div></div>
</Base>
