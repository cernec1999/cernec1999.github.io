---
import Base from '../layouts/Base.astro';
import body from '../resume/body.html?raw';
import '../resume/resume.css';
---
<Base title="Resume" description="Christopher Cerne, Security Engineer, Agent Data Optimization (ADO) at Meta.">
  <div class="wide">
    <div class="resume-actions"><a class="dl-btn" href="/resume.pdf" download="christopher-cerne-resume.pdf">Download PDF</a></div>
    <div class="rsheet">
      <main class="sheet">
        <Fragment set:html={body} />
      </main>
    </div>
  </div>
  <style>
    .resume-actions{display:flex;justify-content:flex-start;margin:26px 0 14px}
    .dl-btn{background:var(--accent);color:#fff;font-weight:700;font-size:14.5px;padding:10px 18px;border-radius:999px;text-decoration:none;box-shadow:0 2px 10px rgba(20,16,12,.35)}
    .dl-btn:hover{background:var(--link);text-decoration:none}
    html[data-theme='dark'] .dl-btn{color:#1c1410}
    /* warm "desk" behind the sheet (option B): staged value step, less glare */
    .rsheet{border-radius:20px;padding:22px 16px;background:#f0e7db}
    html[data-theme='dark'] .rsheet{background:#241a12}
    .rsheet .sheet{border-radius:4px;box-shadow:0 3mm 10mm rgba(20,16,12,.35)}
    @media(max-width:640px){
      .rsheet{padding:12px 6px;border-radius:14px}
      .rsheet .sheet{padding:9mm 6mm;margin:4px auto}
    }
  </style>
</Base>
