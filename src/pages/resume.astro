---
import Base from '../layouts/Base.astro';
import body from '../resume/body.html?raw';
import '../resume/resume.css';
---
<Base title="Resume" description="Christopher Cerne, Security Engineer, Agent Data Optimization (ADO) at Meta.">
  <div class="wide">
    <p style="margin:22px 0 4px"><a class="toggle" style="display:inline-block;padding:9px 16px" href="/resume.pdf" download>Download PDF</a></p>
    <div class="rsheet">
      <main class="sheet">
        <Fragment set:html={body} />
      </main>
    </div>
  </div>
</Base>
