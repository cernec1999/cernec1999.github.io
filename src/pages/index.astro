---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const shelves = (await getCollection('shelves')).sort((a,b)=>a.data.order-b.data.order);
---
<Base>
  <div class="wide">
    <section class="hero">
      <h1>Research, written down.</h1>
      <p>Language-model discoveries, vulnerability research, and the reverse engineering behind it: published as I find things, tagged so you can follow one vein at a time.</p>
      <img class="motif" src="/brand/logo-mark.svg" width="150" alt="" aria-hidden="true" />
    </section>

    <h2 class="sec">Start with a vein</h2>
    <div class="cards">
      {shelves.map((s)=>(
        <a class="card" style={`--a:${s.data.accent}`} href={`/tags/${s.data.tag}`}>
          <b>{s.data.title}</b>
          <p>{s.data.blurb}</p>
          <span class="go">Browse {s.data.title.toLowerCase()} →</span>
        </a>
      ))}
    </div>

    <h2 class="sec">Latest</h2>
    <div class="postlist">{posts.slice(0,10).map((p)=>(<PostCard post={p}/>))}</div>
  </div>
</Base>
