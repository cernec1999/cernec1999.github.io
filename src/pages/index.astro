---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const shelves = (await getCollection('shelves')).sort((a,b)=>a.data.order-b.data.order);
---
<Base>
  <div class="wide">
    <section class="hero">
      <h1>Research, written down.</h1>
      <p>Language-model discoveries, Graal running on a Nintendo Switch, and vulnerability research — published as I find things, tagged so you can follow one vein at a time.</p>
      <svg class="motif" width="220" height="34" viewBox="0 0 220 34" aria-hidden="true"><g fill="var(--accent)"><path d="M14 0h12l-2 14c-.6 3-2 5-4 8-2-3-3.4-5-4-8L14 0z" opacity=".8"/><path d="M70 0h9l-1.5 10c-.5 2.4-1.5 4-3 6-1.5-2-2.5-3.6-3-6L70 0z" opacity=".55"/><path d="M128 0h14l-2.2 16c-.7 3.4-2.3 5.8-4.8 9.4-2.5-3.6-4.1-6-4.8-9.4L128 0z" opacity=".7"/><path d="M188 0h8l-1.3 9c-.4 2-1.3 3.4-2.7 5.2-1.4-1.8-2.3-3.2-2.7-5.2L188 0z" opacity=".45"/></g></svg>
    </section>

    <h2 class="sec">Start with a vein</h2>
    <div class="cards">
      {shelves.map((s)=>(
        <a class="card" style={`--a:${s.data.accent}`} href={`/tags/${s.data.tag}`}>
          <b>{s.data.title}</b>
          <p>{s.data.blurb}</p>
          <span class="go">Browse {s.data.title.toLowerCase()} →</span>
        </a>
      ))}
    </div>

    <h2 class="sec">Latest</h2>
    <div class="postlist">{posts.slice(0,10).map((p)=>(<PostCard post={p}/>))}</div>
  </div>
</Base>
