---
import Base from '../layouts/Base.astro';
---
<Base title="Search" description="Search stalactech.">
  <div class="wrap">
    <h1 class="posttitle">Search</h1>
    <p style="color:var(--muted)">Full-text search over every post. The index is built at publish time by Pagefind and loads only when you open search — nothing is fetched until then.</p>
    <button class="toggle" id="openSearch" type="button" style="padding:10px 18px;font-size:15px">Open search</button>
    <div id="search" style="margin-top:22px"></div>
  </div>
  <script is:inline>
    // Pagefind assets are generated into dist/pagefind at build time; load them
    // at runtime only when the reader opens search (0 KB until then).
    document.getElementById('openSearch')?.addEventListener('click', function () {
      this.remove();
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(link);
      const s = document.createElement('script');
      s.src = '/pagefind/pagefind-ui.js';
      s.onload = () => new window.PagefindUI({ element: '#search', showSubResults: true, autofocus: true });
      document.head.appendChild(s);
    }, { once: true });
  </script>
</Base>
