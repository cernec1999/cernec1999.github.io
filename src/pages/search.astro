---
import Base from '../layouts/Base.astro';
---
<Base title="Search" description="Search stalactech.">
  <div class="wrap">
    <h1 class="posttitle">Search</h1>
    <p style="color:var(--muted)">Full-text search over every post.</p>
    <div id="search" style="margin-top:22px"></div>
  </div>
  <script is:inline>
    // Pagefind assets are generated into dist/pagefind at build time; load them
    // immediately so the reader lands on a ready, focused search box.
    (function () {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(link);
      const s = document.createElement('script');
      s.src = '/pagefind/pagefind-ui.js';
      s.onload = () => new window.PagefindUI({ element: '#search', showSubResults: true, autofocus: true });
      document.head.appendChild(s);
    })();
  </script>
</Base>
